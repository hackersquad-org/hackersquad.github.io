   "who": "narrator",
   "text": "Bryan plants the stop sign at the village gate, straightens his helmet and takes the first watch himself.",
   "file": "narrator/bryan-plants-the-stop-sign-at-the-villag-c2f805dd.mp3",
   "ms": 5721,
   "ch": "defense",
   "for": "bryan"
  },
  "adddbc0b": {
   "who": "narrator",
   "text": "No wolf has come down the valley road since. The sign says STOP, and so does the pig behind it.",
   "file": "narrator/no-wolf-has-come-down-the-valley-road-si-adddbc0b.mp3",
   "ms": 5538,
   "ch": "defense",
   "for": "bryan"
  },
  "4a29f6d8": {
   "who": "narrator",
   "text": "Bryan goes down… and the pack marches on the village.",
   "file": "narrator/bryan-goes-down-and-the-pack-marches-on-4a29f6d8.mp3",
   "ms": 3135,
   "ch": "defense",
   "for": "bryan"
  },
  "0aae0934": {
   "who": "clara",
   "text": "Happy Halloween, wolves. Now shoo.",
   "file": "clara/happy-halloween-wolves-now-shoo-0aae0934.mp3",
   "ms": 2194,
   "ch": "defense",
   "for": "clara"
  },
  "6bc16ff2": {
   "who": "narrator",
   "text": "The lambs say the cat is a witch. The wolves, wherever they ran to, say so too.",
   "file": "narrator/the-lambs-say-the-cat-is-a-witch-the-wol-6bc16ff2.mp3",
   "ms": 5277,
   "ch": "defense",
   "for": "clara"
  },
  "706ca627": {
   "who": "narrator",
   "text": "Clara goes down… and the pack marches on the village.",
   "file": "narrator/clara-goes-down-and-the-pack-marches-on-706ca627.mp3",
   "ms": 3396,
   "ch": "defense",
   "for": "clara"
  },
  "c896c570": {
   "who": "connector",
   "text": "Pffff… back to pocket size. Wolves all gone?",
   "file": "connector/pffff-back-to-pocket-size-wolves-all-gon-c896c570.mp3",
   "ms": 2900,
   "ch": "defense",
   "for": "connector"
  },
  "c8e56108": {
   "who": "narrator",
   "text": "Connector shrinks back to pocket size, burps out one wolf helmet and bounces off toward the village.",
   "file": "narrator/connector-shrinks-back-to-pocket-size-bu-c8e56108.mp3",
   "ms": 5773,
   "ch": "defense",
   "for": "connector"
  },
  "30393d6e": {
   "who": "narrator",
   "text": "Nobody knows what it is or where it came from. The lambs have already built it a bed.",
   "file": "narrator/nobody-knows-what-it-is-or-where-it-came-30393d6e.mp3",
   "ms": 5120,
   "ch": "defense",
   "for": "connector"
  },
  "662b30a7": {
   "who": "narrator",
   "text": "Connector goes down… and the pack marches on the village.",
   "file": "narrator/connector-goes-down-and-the-pack-marches-662b30a7.mp3",
   "ms": 3500,
   "ch": "defense",
   "for": "connector"
  },
  "b2c67d25": {
   "who": "anonymous",
   "text": "Pffff… the wolves saw nothing.",
   "file": "anonymous/pffff-the-wolves-saw-nothing-b2c67d25.mp3",
   "ms": 2142,
   "ch": "defense",
   "for": "anonymous"
  },
  "513d32ec": {
   "who": "narrator",
   "text": "The masked jelly leaves before anyone can thank it. By morning every lamb in the village has drawn a moustache on a paper plate.",
   "file": "narrator/the-masked-jelly-leaves-before-anyone-ca-513d32ec.mp3",
   "ms": 7262,
   "ch": "defense",
   "for": "anonymous"
  },
  "14e78941": {
   "who": "narrator",
   "text": "The wolves never learned who beat them. The village never tells.",
   "file": "narrator/the-wolves-never-learned-who-beat-them-t-14e78941.mp3",
   "ms": 3788,
   "ch": "defense",
   "for": "anonymous"
  },
  "1452abf1": {
   "who": "narrator",
   "text": "Anonymous goes down… and the pack marches on the village.",
   "file": "narrator/anonymous-goes-down-and-the-pack-marches-1452abf1.mp3",
   "ms": 3605,
   "ch": "defense",
   "for": "anonymous"
  }
 }
}
